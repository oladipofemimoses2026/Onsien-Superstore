# Copy to .env for local work. Never commit .env.
# Browser-safe (baked into the build; redeploy after changing on Vercel)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_CONTACT_EMAIL=

# Server only (used inside /api functions, never prefix with VITE_)
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net
MAILGUN_FROM=
# Production only; Preview falls back to VERCEL_URL
APP_URL=
